<Window x:Class="Assignment3.EditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EditWindow" Height="400" Width="600"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <!-- Main layout split into content region and bottom button bar -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Fixed-position Data Fields Area (won't move on window resize) -->
        <Canvas Grid.Row="0">
            <!-- First Name Field -->
            <Label Content="_First Name:" Target="{Binding ElementName=txtFirstName}" Canvas.Left="20" Canvas.Top="20" />
            <TextBox x:Name="txtFirstName" Width="180" Height="25" Canvas.Left="20" Canvas.Top="45" />

            <!-- Last Name Field -->
            <Label Content="_Last Name:" Target="{Binding ElementName=txtLastName}" Canvas.Left="230" Canvas.Top="20" />
            <TextBox x:Name="txtLastName" Width="180" Height="25" Canvas.Left="230" Canvas.Top="45" />

            <!-- Age Field -->
            <Label Content="_Age:" Target="{Binding ElementName=txtAge}" Canvas.Left="20" Canvas.Top="85" />
            <TextBox x:Name="txtAge" Width="180" Height="25" Canvas.Left="20" Canvas.Top="110" />
        </Canvas>

        <!-- Bottom-Right Action Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,10,0,0">
            <Button x:Name="btnOK" 
                    Width="90" Height="30" Margin="0,0,10,0" 
                    IsDefault="True" 
                    Click="BtnOK_Click" 
                    Padding="10,4">
                <AccessText Text="O_K" />
            </Button>

            <Button x:Name="btnCancel" 
                    Width="90" Height="30" 
                    IsCancel="True" 
                    Click="BtnCancel_Click" 
                    Padding="10,4">
                <AccessText Text="Cancel" />
            </Button>
        </StackPanel>
    </Grid>
</Window>
